# Generates a C++ include with the bytes of each file in FILES.
# Usage: cmake -DOUT=<file> -DFILES=<a;b;c> -P embed.cmake
string(REPLACE "|" ";" FILES "${FILES}")
set(content "// generated by cmake/embed.cmake — do not edit\n")
set(index "")
set(i 0)
foreach(f ${FILES})
  get_filename_component(name ${f} NAME)
  file(READ ${f} hex HEX)
  string(LENGTH "${hex}" len)
  math(EXPR bytes "${len} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
  string(APPEND content "static const unsigned char kBlob${i}[${bytes}] = {${hex}};\n")
  string(APPEND index "  {\"${name}\", kBlob${i}, ${bytes}},\n")
  math(EXPR i "${i} + 1")
endforeach()
string(APPEND content "static const EmbeddedFile kEmbedded[] = {\n${index}};\n")
file(WRITE ${OUT}.tmp "${content}")
file(COPY_FILE ${OUT}.tmp ${OUT} ONLY_IF_DIFFERENT)
